# Copie este ficheiro para .env e ajuste os valores antes do primeiro arranque.
IPADDRESS=192.168.1.254
SERVER_URL=
STREMIO_DATA_DIR=stremio-cache
STREMIOSRV_BT_LISTEN_PORT=6881

# Deixe vazio para manter o botão Update now desactivado. O comando é executado dentro do contentor;
# não monte o socket Docker apenas para permitir actualizações pelo Web Admin.
STREMIOSRV_ADMIN_UPDATE_COMMAND=

# Pi-hole integrado. A interface fica sem palavra-passe e deve permanecer apenas na LAN confiável.
TZ=Africa/Luanda
PIHOLE_WEB_PORT=8053
PIHOLE_UPSTREAM_DNS=1.1.1.1;1.0.0.1
